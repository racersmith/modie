{
  "name": "@racersmith/modie",
  "version": "0.0.1",
  "description": "Filesystem-as-DAG architectural governance and task lifecycle engine",
  "license": "MIT",
  "author": "Josh Smith <racersmith@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/racersmith/modie.git"
  },
  "bugs": {
    "url": "https://github.com/racersmith/modie/issues"
  },
  "homepage": "https://github.com/racersmith/modie#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "modie": "./dist/bin/bin.js",
    "modie-mcp": "./dist/bin/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:bundle && bun run build:types",
    "build:bundle": "bun build ./src/index.ts --outdir ./dist --target node && bun build ./src/interfaces/cli/bin.ts --outdir ./dist/bin --target node && bun build ./src/interfaces/mcp/bin.ts --outfile ./dist/bin/mcp.js --target node",
    "build:types": "tsc --declaration --emitDeclarationOnly --noEmit false --rootDir ./src --outDir ./dist/types",
    "modie": "PATH=\"$HOME/.bun/bin:$PATH\" bun --silent ./src/interfaces/cli/bin.ts",
    "typecheck": "bun check",
    "test": "bun test",
    "format": "bun fmt",
    "prepublishOnly": "bun run build && bun test",
    "count:all": "find src -type f \\( -name \"*.ts\" -o -name \"*.tsx\" \\) | xargs wc -l",
    "count:src": "find src -type f \\( -name \"*.ts\" -o -name \"*.tsx\" \\) ! -name \"*.test.ts\" ! -name \"*.spec.ts\" | xargs wc -l"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  }
}
