{
  "name": "@racersmith/modie",
  "version": "0.0.1",
  "description": "Filesystem-as-DAG architectural governance and task lifecycle engine",
  "license": "MIT",
  "author": "Josh Smith <racersmith@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/racersmith/modie.git"
  },
  "bugs": {
    "url": "https://github.com/racersmith/modie/issues"
  },
  "homepage": "https://github.com/racersmith/modie#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "modie": "./dist/bin/bin.js",
    "modie-mcp": "./dist/bin/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build:bundle && bun run build:types",
    "build:bundle": "bun build ./src/index.ts --outdir ./dist --target node && bun build ./src/interfaces/cli/bin.ts --outdir ./dist/bin --target node && bun build ./src/interfaces/mcp/bin.ts --outfile ./dist/bin/mcp.js --target node && cp ./src/interfaces/mcp/instructions.md ./dist/bin/instructions.md",
    "build:types": "tsc --declaration --emitDeclarationOnly --noEmit false --rootDir ./src --outDir ./dist/types",
    "modie": "PATH=\"$HOME/.bun/bin:$PATH\" bun --silent ./src/interfaces/cli/bin.ts",
    "typecheck": "bun check",
    "test:parallel": "bun test --parallel",
    "format": "bun fmt",
    "mcp:inspect": "MODIE_CWD=\"/home/josh/Documents/version_control/modie\" npx @modelcontextprotocol/inspector --catalog .agents/_modie_test_mcp.json",
    "verify": "bun ./scripts/verify.ts",
    "validate:plugin": "bun ./scripts/validate-plugin.ts",
    "plugin:link": "ln -sfn $(pwd)/integrations/antigravity ~/.gemini/config/plugins/modie",
    "prepublishOnly": "bun run build && bun run verify",
    "check:complexity": "bun ./scripts/check-complexity.ts",
    "check:duplication": "jscpd src --pattern '**/*.ts' --ignore '**/*.test.ts' --min-lines 5 --min-tokens 50",
    "check:circular": "bunx dpdm --no-warning --no-tree --exit-code circular:1 ./src/",
    "count:all": "find src -type f \\( -name \"*.ts\" -o -name \"*.tsx\" \\) | xargs wc -l",
    "count:src": "find src -type f \\( -name \"*.ts\" -o -name \"*.tsx\" \\) ! -name \"*.test.ts\" ! -name \"*.spec.ts\" | xargs wc -l",
    "knip": "knip"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "jscpd": "^5.4.2",
    "knip": "^6.45.0",
    "mcp-checkup": "^0.1.9",
    "oxc-parser": "^0.158.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
